{% extends 'base.html.twig' %}

{% block title %}Modifier mon profil - SymfoConnect{% endblock %}

{% block body %}
<div class="glass-card max-w-600 mx-auto p-4 animate__animated animate__fadeIn">
    <h1 class="h3 mb-4 text-center">Modifier mon profil</h1>

    {{ form_start(form) }}
        <div class="form-group mb-3">
            {{ form_label(form.bio) }}
            {{ form_widget(form.bio, {'attr': {'class': 'form-control glass-input'}}) }}
            {{ form_errors(form.bio) }}
        </div>

        <div class="form-group mb-4">
            {{ form_label(form.avatarUrl) }}
            <br>
            <small class="text-muted">Choisissez une image pour votre photo de profil.</small>
            {{ form_widget(form.avatarUrl, {'attr': {'class': 'form-control glass-input'}}) }}
            {{ form_errors(form.avatarUrl) }}
        </div>

        <div class="d-grid gap-2">
            <button type="submit" class="btn btn-primary glass-button p-3">Enregistrer les modifications</button>
            <a href="{{ path('app_profile', {'username': app.user.username}) }}" class="btn btn-outline-secondary">Annuler</a>
        </div>
    {{ form_end(form) }}
</div>

<style>
    .max-w-600 { max-width: 600px; }
    .mx-auto { margin-left: auto; margin-right: auto; }
</style>
{% endblock %}

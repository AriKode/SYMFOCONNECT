{% extends 'base.html.twig' %}

{% block title %}@{{ user.username }} - SymfoConnect{% endblock %}

{% block body %}
    <div class="profile-card">
        <div class="avatar-large">
            {% if user.avatarUrl %}
                <img src="{{ user.avatarUrl }}" alt="{{ user.username }}" style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover;">
            {% else %}
                {{ user.username|slice(0, 1)|upper }}
            {% endif %}
        </div>
        <h1 class="profile-name">@{{ user.username }}</h1>
        <p class="profile-bio">{{ user.bio ?: 'Cet utilisateur n\'a pas encore de bio.' }}</p>
        <div style="margin-top: 1rem; font-size: 0.9rem; color: var(--text-muted);">
            Membre depuis le {{ user.createdAt|date('d/m/Y') }}
        </div>
    </div>

    <h2 class="form-title" style="font-size: 1.5rem;">Ses publications</h2>

    <div class="post-list">
        {% for post in user.posts %}
            <div class="post-card">
                <div class="post-header">
                    <span class="post-date">{{ post.createdAt|date('d/m/Y H:i') }}</span>
                </div>
                <div class="post-content">{{ post.content }}</div>
            </div>
        {% else %}
            <p style="text-align: center; color: var(--text-muted);">Aucun post publié par cet utilisateur.</p>
        {% endfor %}
    </div>
{% endblock %}

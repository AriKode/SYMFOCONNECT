{% extends 'base.html.twig' %}

{% block title %}@{{ user.username }} - SymfoConnect{% endblock %}

{% block body %}
    <div class="profile-card animate__animated animate__fadeIn">
        <div class="avatar-large">
            {% if user.avatarUrl %}
                <img src="{{ user.avatarUrl }}" alt="{{ user.username }}" style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover;">
            {% else %}
                {{ user.username|slice(0, 1)|upper }}
            {% endif %}
        </div>
        <h1 class="profile-name">@{{ user.username }}</h1>
        <p class="profile-bio">{{ user.bio ?: 'Cet utilisateur n\'a pas encore de bio.' }}</p>
        
        <div class="d-flex justify-content-center gap-4 my-4">
            <div class="text-center">
                <div class="h4 mb-0 fw-bold">{{ user.following|length }}</div>
                <small class="text-muted">Abonnements</small>
            </div>
            <div class="text-center">
                <div class="h4 mb-0 fw-bold">{{ user.followers|length }}</div>
                <small class="text-muted">Abonnés</small>
            </div>
        </div>

        {% if app.user == user %}
            <div class="d-flex justify-content-center gap-2">
                <a href="{{ path('app_profile_edit') }}" class="btn btn-primary glass-button">
                    <i class="bi bi-pencil"></i> Modifier le profil
                </a>
                {% if user.avatarUrl %}
                    <a href="{{ path('app_profile_delete_avatar') }}" class="btn btn-danger glass-button" onclick="return confirm('Supprimer la photo de profil ?')">
                        <i class="bi bi-trash"></i> Supprimer la photo
                    </a>
                {% endif %}
            </div>
        {% elseif app.user %}
            <div class="d-flex justify-content-center gap-2">
                <a href="{{ path('app_follow', {'username': user.username}) }}" class="btn {{ app.user.isFollowing(user) ? 'btn-outline-primary' : 'btn-primary' }} glass-button">
                    {{ app.user.isFollowing(user) ? 'Ne plus suivre' : 'Suivre' }}
                </a>
                <a href="{{ path('app_message_show', {'username': user.username}) }}" class="btn btn-secondary glass-button">
                    <i class="bi bi-chat-dots-fill"></i> Message
                </a>
            </div>
        {% endif %}

        <div class="mt-4 small text-muted">
            Membre depuis le {{ user.createdAt|date('d/m/Y') }}
        </div>
    </div>

    <h2 class="h4 mb-4">Publications de {{ user.username }}</h2>

    <div class="post-list">
        {% for post in user.posts|sort((a, b) => b.createdAt <=> a.createdAt) %}
            {% include 'post/_post_card.html.twig' with {'post': post} %}
        {% else %}
            <div class="glass-card p-4 text-center">
                <p class="text-muted mb-0">Aucun post publié par cet utilisateur.</p>
            </div>
        {% endfor %}
    </div>
{% endblock %}

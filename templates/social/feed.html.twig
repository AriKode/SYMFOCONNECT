{% extends 'base.html.twig' %}

{% block title %}Mon Fil d'Actualité - SymfoConnect{% endblock %}

{% block body %}
<div class="feed-layout">
    <div class="container py-4">
        <div class="row justify-content-center">
            <div class="col-md-7">
                <div class="feed-header d-flex justify-content-between align-items-center mb-4">
                    <h1 class="h4 fw-bold mb-0">Fil d'actualité</h1>
                    <div class="header-actions">
                        <a href="{{ path('app_post_new') }}" class="btn btn-light rounded-pill shadow-sm">
                            <i class="bi bi-plus-lg"></i> Créer
                        </a>
                    </div>
                </div>

                {% if message is defined and message %}
                    <div class="fb-post-card p-5 text-center">
                        <i class="bi bi-people text-muted mb-3" style="font-size: 3rem;"></i>
                        <h2 class="h5">{{ message }}</h2>
                        <a href="{{ path('app_home') }}" class="btn btn-primary mt-3">Trouver des amis</a>
                    </div>
                {% else %}
                    <div class="posts-container">
                        {% for post in posts %}
                            {% include 'post/_post_card.html.twig' with {'post': post} %}
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>

<style>
    body { background-color: #f0f2f5 !important; }
    .feed-layout { min-height: 100vh; }
    .feed-header h1 { color: #1c1e21; }
</style>
{% endblock %}

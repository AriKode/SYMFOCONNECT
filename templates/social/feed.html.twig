{% extends 'base.html.twig' %}

{% block title %}Mon Fil d'Actualité - SymfoConnect{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-md-8">
        <h1 class="h3 mb-4 animate__animated animate__fadeInLeft">Mon Fil d'Actualité</h1>

        {% if message is defined and message %}
            <div class="glass-card p-5 text-center animate__animated animate__zoomIn">
                <div class="mb-4">
                    <i class="bi bi-people text-primary" style="font-size: 3rem;"></i>
                </div>
                <h2 class="h4">{{ message }}</h2>
                <a href="{{ path('app_home') }}" class="btn btn-primary mt-3 glass-button">Découvrir des personnes</a>
            </div>
        {% else %}
            <div class="posts-container">
                {% for post in posts %}
                    {% include 'post/_post_card.html.twig' with {'post': post} %}
                {% endfor %}
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}

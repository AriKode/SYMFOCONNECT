{% extends 'base.html.twig' %}

{% block title %}Connexion - SymfoConnect{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="glass-card p-5 animate__animated animate__fadeInDown">
            <h1 class="h2 mb-4 text-center">Connexion</h1>

            <form method="post">
                {% if error %}
                    <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                {% endif %}

                <div class="mb-3">
                    <label for="inputEmail">Email</label>
                    <input type="email" value="{{ last_username }}" name="_username" id="inputEmail" class="form-control glass-input" autocomplete="email" required autofocus>
                </div>
                
                <div class="mb-4">
                    <label for="inputPassword">Mot de passe</label>
                    <input type="password" name="_password" id="inputPassword" class="form-control glass-input" autocomplete="current-password" required>
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button class="btn btn-primary w-100 py-3 glass-button" type="submit">
                    C'est parti !
                </button>
            </form>

            <div class="mt-4 text-center">
                <p class="text-muted">Pas encore membre ? <a href="{{ path('app_register') }}" class="text-primary fw-bold">Créez un compte</a></p>
            </div>
        </div>
    </div>
</div>
{% endblock %}

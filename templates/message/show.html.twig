{% extends 'base.html.twig' %}

{% block title %}Conversation avec @{{ recipient.username }}{% endblock %}

{% block body %}
<div class="messenger-wrapper animate__animated animate__fadeIn">
    <div class="messenger-container">
        {# Header style Facebook #}
        <div class="messenger-header">
            <a href="{{ path('app_messages') }}" class="back-button"><i class="bi bi-chevron-left"></i></a>
            <div class="header-user">
                <div class="avatar-status">
                    <img src="{{ recipient.avatarUrl ?: 'https://ui-avatars.com/api/?name=' ~ recipient.username }}" alt="{{ recipient.username }}">
                    <span class="status-online"></span>
                </div>
                <div class="user-details">
                    <span class="user-name">@{{ recipient.username }}</span>
                    <span class="user-status">En ligne</span>
                </div>
            </div>
            <div class="header-actions">
                <i class="bi bi-telephone-fill"></i>
                <i class="bi bi-camera-video-fill"></i>
                <i class="bi bi-info-circle-fill"></i>
            </div>
        </div>

        {# Zone de discussion #}
        <div class="messenger-chat" id="chat-messages">
            {% for message in messages %}
                <div class="message-row {{ message.sender == app.user ? 'sent' : 'received' }}" id="message-{{ message.id }}">
                    {% if message.sender != app.user %}
                        <img src="{{ recipient.avatarUrl ?: 'https://ui-avatars.com/api/?name=' ~ recipient.username }}" class="msg-avatar">
                    {% endif %}
                    
                    <div class="bubble-container">
                        {% if message.parentMessage %}
                            <div class="quoted-message">
                                <small>Réponse à :</small>
                                <div class="quoted-content">{{ message.parentMessage.content|slice(0, 50) }}...</div>
                            </div>
                        {% endif %}

                        <div class="message-bubble">
                            <div class="bubble-text">{{ message.content }}</div>
                            <div class="message-actions-overlay">
                                <button class="btn-reply" onclick="replyTo({{ message.id }}, '{{ message.content|escape('js') }}')">
                                    <i class="bi bi-reply-fill"></i> Répondre
                                </button>
                            </div>
                        </div>
                        {# Date et heure en bas + indicateur de lecture #}
                        <div class="msg-footer">
                            <span class="bubble-full-date">
                                {{ message.createdAt|date('d/m/Y à H:i') }}
                            </span>
                            {% if message.sender == app.user %}
                                <span class="read-status {{ message.isRead ? 'read' : 'sent' }}">
                                    {{ message.isRead ? '· Vu' : '· Envoyé' }}
                                </span>
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>

        {# Aperçu de la réponse #}
        <div id="reply-preview" class="reply-preview" style="display: none;">
            <div class="reply-preview-content">
                <small>En réponse à :</small>
                <p id="reply-text"></p>
            </div>
            <button class="btn-close-reply" onclick="cancelReply()"><i class="bi bi-x"></i></button>
        </div>

        {# Zone de saisie avec Emoji Picker #}
        <div class="messenger-input-area">
            {{ form_start(form, {'attr': {'class': 'messenger-form'}}) }}
                <input type="hidden" name="parent_id" id="parent-id-input">
                <div class="input-actions">
                    <i class="bi bi-plus-circle-fill"></i>
                    <i class="bi bi-images"></i>
                    <i class="bi bi-sticky-fill"></i>
                </div>
                <div class="input-wrapper">
                    {{ form_widget(form.content, {'attr': {'placeholder': 'Aa', 'class': 'messenger-input'}}) }}
                    <button type="button" id="emoji-trigger" class="btn-emoji">
                        <i class="bi bi-emoji-smile-fill"></i>
                    </button>
                </div>
                <button type="submit" class="btn-send-msg">
                    <i class="bi bi-send-fill"></i>
                </button>
            {{ form_end(form) }}
        </div>
    </div>
</div>

{# Emoji Picker Libraries #}
<script src="https://cdn.jsdelivr.net/npm/@joeattardi/emoji-button@4.6.4/dist/index.min.js"></script>

<style>
    :root {
        --fb-blue: #0084ff;
        --fb-bg: #f0f2f5;
        --fb-gray: #e4e6eb;
        --fb-received: #f1f0f0;
    }

    .messenger-wrapper { height: calc(100vh - 120px); max-width: 900px; margin: 1rem auto; }
    .messenger-container { display: flex; flex-direction: column; height: 100%; background: white; border-radius: 12px; box-shadow: 0 12px 28px rgba(0,0,0,0.1); overflow: hidden; }

    .messenger-header { display: flex; align-items: center; padding: 10px 16px; border-bottom: 1px solid rgba(0,0,0,0.1); }
    .avatar-status img { width: 40px; height: 40px; border-radius: 50%; }
    .header-actions { display: flex; gap: 20px; color: var(--fb-blue); }

    .messenger-chat { flex: 1; overflow-y: auto; padding: 20px; display: flex; flex-direction: column; gap: 15px; }
    .message-row { display: flex; align-items: flex-end; gap: 10px; }
    .message-row.sent { flex-direction: row-reverse; }
    .bubble-container { display: flex; flex-direction: column; max-width: 70%; }
    .sent .bubble-container { align-items: flex-end; }
    
    .message-bubble { padding: 10px 15px; border-radius: 20px; position: relative; }
    .sent .message-bubble { background: var(--fb-blue); color: white; }
    .received .message-bubble { background: var(--fb-received); color: #050505; }

    .bubble-full-date { font-size: 0.65rem; color: #8e8e8e; }
    .msg-footer { display: flex; gap: 4px; align-items: center; margin-top: 4px; }
    .sent .msg-footer { justify-content: flex-end; }
    .read-status { font-size: 0.65rem; font-weight: 600; color: #8e8e8e; }
    .read-status.read { color: var(--fb-blue); }

    .message-actions-overlay { position: absolute; top: 50%; transform: translateY(-50%); display: none; }
    .sent .message-actions-overlay { right: 105%; }
    .received .message-actions-overlay { left: 105%; }
    .message-row:hover .message-actions-overlay { display: block; }
    .btn-reply { background: none; border: none; color: #8e8e8e; font-size: 0.8rem; cursor: pointer; }

    .quoted-message { background: rgba(0,0,0,0.05); padding: 5px 10px; border-radius: 10px; margin-bottom: -10px; padding-bottom: 15px; font-size: 0.8rem; border-left: 3px solid var(--fb-blue); }

    .reply-preview { padding: 10px 16px; background: #f0f2f5; display: flex; justify-content: space-between; align-items: center; }
    .btn-close-reply { background: none; border: none; font-size: 1.5rem; cursor: pointer; }

    .messenger-input-area { padding: 15px; }
    .messenger-form { display: flex; align-items: center; gap: 15px; }
    .input-wrapper { flex: 1; background: #f0f2f5; border-radius: 25px; display: flex; align-items: center; padding: 5px 15px; }
    .messenger-input { border: none !important; background: transparent !important; flex: 1; box-shadow: none !important; }
    
    .btn-emoji { background: none; border: none; color: var(--fb-blue); cursor: pointer; font-size: 1.2rem; display: flex; align-items: center; }
    .btn-send-msg { background: none; border: none; color: var(--fb-blue); font-size: 1.5rem; cursor: pointer; }
</style>

<script>
    const chatMessages = document.getElementById('chat-messages');
    chatMessages.scrollTop = chatMessages.scrollHeight;

    function replyTo(id, text) {
        document.getElementById('parent-id-input').value = id;
        document.getElementById('reply-text').innerText = text.substring(0, 50) + "...";
        document.getElementById('reply-preview').style.display = 'flex';
        document.querySelector('.messenger-input').focus();
    }

    function cancelReply() {
        document.getElementById('parent-id-input').value = '';
        document.getElementById('reply-preview').style.display = 'none';
    }

    // Emoji Picker Initialization
    const picker = new EmojiButton({
        position: 'top-start',
        theme: 'light'
    });
    const trigger = document.querySelector('#emoji-trigger');
    const input = document.querySelector('.messenger-input');

    picker.on('emoji', selection => {
        input.value += selection;
    });

    trigger.addEventListener('click', () => picker.togglePicker(trigger));
</script>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Accueil - SymfoConnect{% endblock %}

{% block body %}
    <h1 class="form-title">Fil d'actualité</h1>

    <div class="post-list">
        {% for post in posts %}
            {% include 'post/_post_card.html.twig' with {'post': post} %}
        {% else %}
            <div class="glass-card p-5 text-center animate__animated animate__zoomIn">
                <p class="text-muted">Aucun post pour le moment. Soyez le premier à en publier un !</p>
                <a href="{{ path('app_post_new') }}" class="btn btn-primary mt-3 glass-button">🚀 Créer un post</a>
            </div>
        {% endfor %}
    </div>
{% endblock %}
